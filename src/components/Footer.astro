---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import SiteBrandMark from './SiteBrandMark.astro';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive', ariaLabel: 'Blog' },
  { href: '/products/war-thunder/elite/', label: 'Elite cheats', ariaLabel: 'Elite cheats' },
  { href: '/products/war-thunder/', label: 'Products & utilities', ariaLabel: 'Products' },
  { href: '/support/', label: t.footer.support },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const onPrivacyPage = normalizedPath === '/privacy';
const onHomePage = normalizedPath === '/';
const onAboutPage = normalizedPath === '/about';
const onBlogPage = normalizedPath === '/blog';
const onFaqPage = normalizedPath === '/faq';
const onPracticeLobbyPost = normalizedPath === '/blog/wt-test-drive-practice';
const onStreamProofPost = normalizedPath === '/blog/wt-stream-proof';
const onRadarPost = normalizedPath === '/blog/wt-radar';
const onForumPage = normalizedPath === '/forum';
const onProductsHub = normalizedPath === '/products/war-thunder';

---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <SiteBrandMark showIcon class="max-w-xs" />
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                {onProductsHub && link.href === '/blog/'
                  ? 'Product hub — patch setup guides'
                  : onProductsHub && link.href === '/support/'
                    ? 'Product hub — loader and checkout support'
                    : onProductsHub && link.href === '/products/war-thunder/elite/'
                      ? 'Elite tier from catalog hub'
                      : onProductsHub && link.href === '/products/war-thunder/'
                        ? 'War Thunder catalog (you are here)'
                        : onForumPage && link.href === '/blog/'
                          ? 'Forum sidebar — War Thunder guides'
                          : onPrivacyPage && link.href === '/support/'
                            ? 'Privacy questions — shop support'
                            : onHomePage && link.href === '/support/'
                              ? 'Homepage loader and checkout support'
                              : onAboutPage && link.href === '/support/'
                                ? 'About page — loader and checkout support'
                                : onBlogPage && link.href === '/support/'
                                  ? 'Blog index — setup and loader support'
                                  : onFaqPage && link.href === '/support/'
                                    ? 'FAQ — loader and checkout support'
                                    : onPracticeLobbyPost && link.href === '/support/'
                                      ? 'Test Drive guide — loader support'
                                      : onStreamProofPost && link.href === '/support/'
                                        ? 'Stream-proof guide — capture support'
                                        : onRadarPost && link.href === '/support/'
                                          ? 'Radar guide — loader support'
                                          : onRadarPost && link.href === '/blog/'
                                            ? 'Radar article hub — more guides'
                                            : onRadarPost && link.href === '/products/war-thunder/elite/'
                                              ? 'Elite tier from radar guide sidebar'
                                              : onRadarPost && link.href === '/products/war-thunder/'
                                                ? 'War Thunder shop linked from radar guide'
                                                : onForumPage && link.href === '/support/'
                                                  ? 'Forum — loader and checkout support'
                                                  : link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
                {onForumPage && link.href === '/about/' ? 'Footer — about cheatswarthunder.net' : link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
